{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidone-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*"]
  },
  "workers_dev": false,
  "preview_urls": false
}
