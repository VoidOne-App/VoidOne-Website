{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidone-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*"]
  },
  "r2_buckets": [
    {
      "binding": "VOIDONE_DOWNLOADS",
      "bucket_name": "voidone-downloads"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
