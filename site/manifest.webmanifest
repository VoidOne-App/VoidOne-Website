{
  "name": "VoidOne — Your Games. Your Hardware. Your Rules.",
  "short_name": "VoidOne",
  "description": "VoidOne is a native, open-source PC gaming platform built around the games you already own — not a storefront.",
  "lang": "en",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#05070a",
  "theme_color": "#05070a",
  "categories": ["games", "utilities", "developer"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icons/voidone-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Downloads",
      "short_name": "Download",
      "description": "Official VoidOne releases, installer and portable package",
      "url": "./downloads/",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Developers",
      "short_name": "Developers",
      "description": "Architecture, build guide, CI/CD and contribution",
      "url": "./developers/",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Project",
      "short_name": "Project",
      "description": "Manifesto, evolution timeline and roadmap",
      "url": "./project/",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
